# Android SDK path
# Set this to your Android SDK location
# Example on macOS: /Users/username/Library/Android/sdk
# Example on Linux: /home/username/Android/Sdk
# Example on Windows: C:\\Users\\username\\AppData\\Local\\Android\\Sdk
sdk.dir=/home/atul/Android/Sdk

